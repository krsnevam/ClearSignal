{
  "name": "edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:node": "node --env-file-if-exists=../../.env --import tsx --import ../../scripts/register-yaml.mjs --watch src/node.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx --import ../../scripts/register-yaml.mjs src/node.ts",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clearsignal/db-schema": "workspace:*",
    "@clearsignal/fusion": "workspace:*",
    "@clearsignal/kodagu-fixtures": "workspace:*",
    "@clearsignal/schema": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@neondatabase/serverless": "^0.10.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.95.0"
  }
}
