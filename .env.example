# ── Edge API (apps/edge) ────────────────────────────────────────
# Leave DATABASE_URL empty to run on the in-memory store (demo/replay mode).
DATABASE_URL=
# Shared secret the Python worker uses to POST /ingest
INGEST_TOKEN=dev-ingest-token
# Twilio auth token — used to verify X-Twilio-Signature on /sms-webhook
TWILIO_AUTH_TOKEN=
# MSG91 inbound webhook shared secret (sent as ?token=…)
MSG91_WEBHOOK_TOKEN=
# Scenario replay: "kodagu-2018" or "off" (live sources only)
REPLAY_MODE=kodagu-2018
REPLAY_SPEED=60
# Presenter controls (restart / speed / pause) in the app's Options sheet without a token.
# Keep "on" locally; production (wrangler.toml) sets "off".
DEMO_CONTROLS=on
# Reply to each citizen SMS with a short acknowledgement (costs one outbound SMS each).
SMS_ACK=on
# Max SMS accepted per sender per 10 minutes.
SMS_RATE_LIMIT=5
# 09:00 IST on 16 Aug 2018 — the video slice start (§12.4)
REPLAY_SIM_START=2018-08-16T03:30:00Z

# ── Web (apps/web) ──────────────────────────────────────────────
# Leave unset locally: the app calls /api, which Vite proxies to the API.
# Set only for production builds, e.g. https://api.clearsignal.app
VITE_API_BASE=
VITE_TURSO_URL=
VITE_TURSO_TOKEN=

# ── Python worker (workers/python) ──────────────────────────────
EDGE_INGEST_URL=http://localhost:8787/ingest
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=
IMD_API_KEY=
FIRMS_MAP_KEY=
